  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport json\r\nimport os\r\nimport time\r\n\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import ElementId, BuiltInParameter\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\njson_path = IN[0]\r\ntick = IN[1]  # tetik için\r\n\r\nlock_path = json_path + \".lock\"\r\n\r\ndef acquire_lock(timeout_sec=2.0, poll=0.05):\r\n    t0 = time.time()\r\n    while True:\r\n        try:\r\n            if not os.path.exists(lock_path):\r\n                f = open(lock_path, \"w\")\r\n                f.write(\"lock\")\r\n                f.close()\r\n                return True\r\n            else:\r\n                raise Exception(\"locked\")\r\n        except:\r\n            if time.time() - t0 > timeout_sec:\r\n                return False\r\n            time.sleep(poll)\r\n\r\ndef release_lock():\r\n    try:\r\n        if os.path.exists(lock_path):\r\n            os.remove(lock_path)\r\n    except:\r\n        pass\r\n\r\ndef safe_read_json(max_retry=10, poll=0.05):\r\n    if not os.path.exists(json_path):\r\n        return {}\r\n    for _ in range(max_retry):\r\n        got = acquire_lock(1.5, poll)\r\n        if not got:\r\n            time.sleep(poll)\r\n            continue\r\n        try:\r\n            f = open(json_path, \"r\")\r\n            txt = f.read()\r\n            f.close()\r\n            txt = (txt or \"\").strip()\r\n            if not txt:\r\n                return {}\r\n            return json.loads(txt)\r\n        except:\r\n            time.sleep(poll)\r\n        finally:\r\n            release_lock()\r\n    return {}\r\n\r\ndef safe_write_json(data):\r\n    got = acquire_lock(2.0, 0.05)\r\n    if not got:\r\n        raise Exception(\"JSON kilitli (Flask yazıyor olabilir).\")\r\n    try:\r\n        tmp = json_path + \".tmp\"\r\n        txt = json.dumps(data, indent=4, ensure_ascii=False)  # ✅ str\r\n        f = open(tmp, \"w\")\r\n        f.write(txt)  # ✅ bytes yok\r\n        f.close()\r\n        if os.path.exists(json_path):\r\n            try:\r\n                os.remove(json_path)\r\n            except:\r\n                pass\r\n        os.rename(tmp, json_path)\r\n    finally:\r\n        release_lock()\r\n\r\ndef get_comments_param(el):\r\n    p = el.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS)\r\n    if p:\r\n        return p\r\n    return el.LookupParameter(\"Comments\") or el.LookupParameter(\"Yorumlar\") or el.LookupParameter(\"Açıklamalar\")\r\n\r\ndata = safe_read_json()\r\n\r\nlocked_ids = []\r\nfor eid, obj in (data or {}).items():\r\n    if isinstance(obj, dict) and obj.get(\"Kilit\") == True:\r\n        locked_ids.append(eid)\r\n\r\nupdated = 0\r\nskipped = 0\r\nerrors = []\r\n\r\nif locked_ids:\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n    for eid_str in locked_ids:\r\n        obj = data.get(eid_str, {})\r\n        note = (obj.get(\"Asistan_Notu\") or \"\").strip()\r\n\r\n        if not note:\r\n            obj[\"Kilit\"] = False\r\n            skipped += 1\r\n            continue\r\n\r\n        try:\r\n            el = doc.GetElement(ElementId(int(eid_str)))\r\n            if el is None:\r\n                obj[\"Kilit\"] = False\r\n                obj[\"LastError\"] = \"Element bulunamadı\"\r\n                skipped += 1\r\n                continue\r\n\r\n            p = get_comments_param(el)\r\n            if p is None or p.IsReadOnly:\r\n                obj[\"Kilit\"] = False\r\n                obj[\"LastError\"] = \"Comments parametresi yok veya read-only\"\r\n                skipped += 1\r\n                continue\r\n\r\n            p.Set(note)\r\n            obj[\"Kilit\"] = False\r\n            obj[\"LastError\"] = \"\"\r\n            obj[\"LastWrite\"] = time.strftime(\"%H:%M:%S\")\r\n            updated += 1\r\n\r\n        except Exception as e:\r\n            obj[\"LastError\"] = str(e)\r\n            errors.append(\"ID {}: {}\".format(eid_str, str(e)))\r\n\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n\r\ntry:\r\n    safe_write_json(data)\r\nexcept Exception as e:\r\n    errors.append(\"JSON yazma hatası: \" + str(e))\r\n\r\nOUT = \"Bekleniyor... ({} kilitli | {} güncellendi | {} atlandı | {} hata)\".format(\r\n    len(locked_ids), updated, skipped, len(errors)\r\n), errors",
      "Engine": "CPython3",
